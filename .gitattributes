# Preserve the exact imported Windows export bytes and pinned vendor source.
# This also keeps archive/clean-room hashes stable under core.autocrlf=true.
/.gitattributes text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
pipeline/** text eol=lf
bench/** text eol=lf
tests/** text eol=lf
scripts/*.py text eol=lf
app/** -text
vendor/** -text
